    "source_identity": "partial_mu D_static^-1 = i Gamma_static^0",
    "full_vertex": "Gamma_static^0=-i partial_mu[m^2-mu^2+Sigma_mean+Sigma_quartic+Sigma_mix+Sigma_vac]",
