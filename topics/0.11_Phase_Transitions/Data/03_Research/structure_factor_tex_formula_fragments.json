      "claim_boundary": "Formula fragments are extracted for review only; estimator policy is not accepted.",
      "extracted_fragment_count": 10,
      "fragments": [
        {
          "formula_label": "Eqn_Gen_OrdParam_Evo",
          "fragment_id": "longo_2021_cahn_hilliard_structure_factor:Eqn_Gen_OrdParam_Evo",
          "fragment_status": "extracted",
          "line_end": 111,
          "line_start": 109,
          "source_id": "longo_2021_cahn_hilliard_structure_factor",
          "tex": "\\label{Eqn_Gen_OrdParam_Evo} \\pdv{\\hat{c}_A}{t} = M\\laplacian{\\hat{\\mu}}-L\\hat{\\mu} - K\\hat{c}_A",
          "tex_member": "StructureFactor.tex"
        },
        {
          "formula_label": "Eqn_Gen_Chem_Pot",
          "fragment_id": "longo_2021_cahn_hilliard_structure_factor:Eqn_Gen_Chem_Pot",
          "fragment_status": "extracted",
          "line_end": 115,
          "line_start": 113,
          "source_id": "longo_2021_cahn_hilliard_structure_factor",
          "tex": "\\label{Eqn_Gen_Chem_Pot} \\hat{\\mu} = \\frac{{\\mu}}{k_\\text{B}T_\\text{c}} = \\frac{1}{2}(1+\\Delta \\hat{T})\\ln\\left(\\frac{1+\\hat{c}_A}{1-\\hat{c}_A}\\right)-\\hat{c}_A -\\kappa\\laplacian{\\hat{c}_A}",
          "tex_member": "StructureFactor.tex"
        },
        {
          "formula_label": "Eqn-omega(q)",
          "fragment_id": "longo_2021_cahn_hilliard_structure_factor:Eqn-omega(q)",
          "fragment_status": "extracted",
          "line_end": 119,
          "line_start": 117,
          "source_id": "longo_2021_cahn_hilliard_structure_factor",
          "tex": "\\label{Eqn-omega(q)} \\omega(q,t) = M\\kappa q_m^2(t) [q_m^2(t) -2q_-^2]-M\\kappa [q^2-q_m^2(t)]^2",
          "tex_member": "StructureFactor.tex"
        },
        {
          "formula_label": "Eqn_Char_Wavenums",
          "fragment_id": "longo_2021_cahn_hilliard_structure_factor:Eqn_Char_Wavenums",
          "fragment_status": "extracted",
          "line_end": 123,
          "line_start": 121,
          "source_id": "longo_2021_cahn_hilliard_structure_factor",
          "tex": "\\label{Eqn_Char_Wavenums} q_m^2 = -\\frac{(M\\hat{\\chi}_{q=0}^{-1}(t)+L\\kappa)}{2M\\kappa} \\quad\\text{and}\\quad q_-^2 = -\\frac{(K+L\\Delta\\hat{T})}{M\\Delta\\hat{T}+L\\kappa}",
          "tex_member": "StructureFactor.tex"
        },
        {
          "formula_label": "Eqn_Sqt_long",
          "fragment_id": "longo_2021_cahn_hilliard_structure_factor:Eqn_Sqt_long",
          "fragment_status": "extracted",
          "line_end": 145,
          "line_start": 143,
          "source_id": "longo_2021_cahn_hilliard_structure_factor",
          "tex": "\\label{Eqn_Sqt_long} S(q,t) = S_\\infty(q) - \\left[S(q,t=0)+S_\\infty(q)\\right]e^{2\\omega(q,t)t}",
          "tex_member": "StructureFactor.tex"
        },
        {
          "formula_label": "Eq-Schi",
          "fragment_id": "longo_2021_cahn_hilliard_structure_factor:Eq-Schi",
          "fragment_status": "extracted",
          "line_end": 149,
          "line_start": 147,
          "source_id": "longo_2021_cahn_hilliard_structure_factor",
          "tex": "\\label{Eq-Schi} S(q,t\\to\\infty) = S_\\infty(q) = \\frac{Mq^2 + L\\kappa}{-\\omega(q,t\\to\\infty)}",
          "tex_member": "StructureFactor.tex"
        },
        {
          "formula_label": "Eqn-SCH",
          "fragment_id": "longo_2021_cahn_hilliard_structure_factor:Eqn-SCH",
          "fragment_status": "extracted",
          "line_end": 155,
          "line_start": 153,
          "source_id": "longo_2021_cahn_hilliard_structure_factor",
          "tex": "\\label{Eqn-SCH} S(q,t) = S_{\\infty}(q)\\left(1 - e^{2\\omega(q,t)t}\\right)",
          "tex_member": "StructureFactor.tex"
        },
        {
          "formula_label": "Eq_Empir_Schi",
          "fragment_id": "longo_2021_cahn_hilliard_structure_factor:Eq_Empir_Schi",
          "fragment_status": "extracted",
          "line_end": 210,
          "line_start": 208,
          "source_id": "longo_2021_cahn_hilliard_structure_factor",
          "tex": "\\label{Eq_Empir_Schi} S_\\infty(q) = \\frac{S_0a^2(q^2+L_\\text{eff})}{a^2q_-^4+[q^2-(1+a)q_-^2]^2}",
          "tex_member": "StructureFactor.tex"
        },
        {
          "formula_label": "S(q,t) = \\int",
          "fragment_id": "longo_2021_cahn_hilliard_structure_factor:inline:1",
          "fragment_status": "extracted_inline",
          "line_end": 136,
          "line_start": 136,
          "source_id": "longo_2021_cahn_hilliard_structure_factor",
          "tex": "S(q,t) = \\int \\dd{\\vec{r}}<\\delta \\hat{c}(\\vec{r},t)\\delta \\hat{c}(\\vec{r}_0,t)>e^{i\\vec{q}\\cdot\\vec{r} }",
          "tex_member": "StructureFactor.tex"
        },
        {
          "formula_label": "\\pdv{S(q,t)}{t}",
          "fragment_id": "longo_2021_cahn_hilliard_structure_factor:inline:2",
          "fragment_status": "extracted_inline",
          "line_end": 140,
          "line_start": 140,
          "source_id": "longo_2021_cahn_hilliard_structure_factor",
          "tex": "\\pdv{S(q,t)}{t} = 2\\omega(q,t)S(q,t) + 2\\left(Mq^2 + L\\kappa\\right)",
          "tex_member": "StructureFactor.tex"
        }
