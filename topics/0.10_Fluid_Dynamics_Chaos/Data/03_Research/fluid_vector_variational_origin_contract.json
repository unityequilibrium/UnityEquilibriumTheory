    "conservative_Q": "h*D_t Q=-mu_Phi",
    "p_Phi": "h*Q",
    "m": "rho0*u+h*Q*grad Phi",
    "H": "|m-p_Phi*grad Phi|^2/(2*rho0)+p_Phi^2/(2*h)+f",
    "hessian_determinant": "h*rho0^dimension"
  },
  "origin": {
