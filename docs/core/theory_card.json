      "level": "L1_CONSISTENT"
    },
    {
      "formula_id": "UET-PARENT-METRIC-EOM",
      "expression": "F(G + Lambda g) + epsilon(g box f - nabla nabla f) = kappa(T_chi + T_int + epsilon T_phi), f = xi delta^2",
      "code_path": "docs/core/02_equations/covariant/uet_covariant_response.py::uet_metric_residual",
      "level": "L1_CONSISTENT"
    },
    {
      "formula_id": "UET-PARENT-SCALAR-EOM",
      "expression": "epsilon[k box phi - U'(phi) + f'(phi)(R - 2Lambda)/(2kappa)] + epsilon h |chi|^2/2 = 0",
      "code_path": "docs/core/02_equations/covariant/uet_covariant_matter.py::coupled_response_scalar_equation_residual",
      "level": "L1_CONSISTENT"
    },
    {
      "formula_id": "UET-PARENT-MATTER-EOM",
      "expression": "Z box chi_A - (m2 + lambda_chi|chi|^2 - epsilon h delta) chi_A = 0",
      "code_path": "docs/core/02_equations/covariant/uet_covariant_matter.py::matter_eom_residual",
      "level": "L1_CONSISTENT"
    }
  ],
