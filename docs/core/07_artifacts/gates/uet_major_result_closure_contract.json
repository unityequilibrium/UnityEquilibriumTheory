{
  "schema_version": "uet-major-result-closure-v1",
  "artifact": "uet_major_result_closure_contract",
  "purpose": "Report research progress as closed results rather than checkpoint counts.",
  "claim_promotion": false,
  "closure_levels": [
    "OPEN",
    "PARTIAL",
    "CLOSED_AS_NO_GO",
    "CLOSED_FOR_LANE",
    "CLOSED_FOR_CORE",
    "CLOSED_FOR_EXTERNAL_CLAIM"
  ],
  "required_fields": [
    "major_result_id",
    "topic",
    "closure_level",
    "what_is_closed",
    "equation_or_mapping",
    "units",
    "derivation_class",
    "observable",
    "data_role",
    "evidence_artifacts",
    "verification_status",
    "open_blockers",
    "dependency_unlocked",
    "claim_boundary"
  ],
  "rules": {
    "pass_is_not_closure": true,
    "blocked_evidence_may_support_partial_result": true,
    "closed_for_core_requires_explicit_evidence": true,
    "holdout_fit_forbidden": true,
    "global_claim_promotion_forbidden": true,
    "ontology_change_requires_registry_mapping": true
  },
  "required_report_headings": [
    "MAJOR_RESULT_CLOSURE",
    "WHAT_IS_ACTUALLY_CLOSED",
    "WHAT_REMAINS_OPEN",
    "DEPENDENCY_UNLOCKED",
    "STATUS",
    "WHAT_CHANGED",
    "EQUATION_OR_MAPPING",
    "VERIFICATION",
    "CONTROLLING_BLOCKER",
    "NEXT_ACTION",
    "CLAIM_BOUNDARY"
  ]
}
