      "source_grade_uncertainty_not_closed_by_mass_only_sensitivity"
    ],
    "dependency_unlocked": "isotope mass sensitivity lane only; no Ding C_src, alpha_Phi_K, transport, Core, Gravity, or Galaxy unlock",
