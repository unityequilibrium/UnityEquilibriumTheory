Cell["Steady-state solution of the viscous heat equation", "Title",
 CellChangeTimes->{{3.753192892188744*^9, 3.753192893738428*^9}, {
  3.753192929746483*^9, 3.753192979084681*^9}, {3.7534445503744297`*^9, 
